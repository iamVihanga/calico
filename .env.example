# Client environment (inlined into the app; safe to ship). Copy to .env.
# Local stack: `supabase start` prints the API URL and the anon / publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_KEY=
# Google Cloud OAuth *Web* client id (the same one configured in Supabase → Auth → Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Phase 8
EXPO_PUBLIC_SENTRY_DSN=

# Local `supabase start` reads these for [auth.external.google] in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
