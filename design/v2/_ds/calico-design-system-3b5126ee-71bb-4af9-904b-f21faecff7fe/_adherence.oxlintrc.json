{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/reading/**",
              "ui_kits/calico-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Caveat|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Caveat, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|action|time|avatarSrc|ring|trailing|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActivityRow> doesn't accept that prop. Declared props: name, action, time, avatarSrc, ring, trailing, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:none|accent|forest|pink|honey)$/]",
        "message": "<ActivityRow> ring must be one of 'none' | 'accent' | 'forest' | 'pink' | 'honey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|inverse)$/]",
        "message": "<ActivityRow> tone must be one of 'paper' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|ring|tone|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, ring, tone, style."
      },
